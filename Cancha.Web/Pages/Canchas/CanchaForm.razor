@using Cancha.Web.Extensions
@using Microsoft.AspNetCore.Components.Forms

<EditForm Model="Cancha" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" />
    
    <div class="mb-3">
        <label>Nombre de la Cancha:</label>
        <div>
            <InputText class="form-control" @bind-Value="Cancha.Nombre" />
            <ValidationMessage For="@(() => Cancha.Nombre)" class="text-danger" />
        </div>
    </div>

    <div class="mb-3">
        <label>Tipo de Cancha:</label>
        <div>
            <InputSelect class="form-select" @bind-Value="Cancha.Tipo">
                <option value="">Seleccione un tipo</option>
                @foreach (var tipo in EnumExtensions.GetEnumList<TipoCancha>())
                {
                    <option value="@tipo.Value">@tipo.DisplayName</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => Cancha.Tipo)" class="text-danger" />
        </div>
    </div>

    <div class="mb-3">
        <label>Precio por Hora:</label>
        <div>
            <InputNumber class="form-control" @bind-Value="Cancha.PrecioHora" step="0.01" />
            <ValidationMessage For="@(() => Cancha.PrecioHora)" class="text-danger" />
        </div>
    </div>

    <div class="mb-3 form-check">
        <InputCheckbox class="form-check-input" @bind-Value="Cancha.Activa" />
        <label class="form-check-label">¿Cancha Activa?</label>
    </div>

    <button class="btn btn-primary" type="submit">Guardar</button>
    <button class="btn btn-secondary" type="button" @onclick="ReturnAction">Regresar</button>
</EditForm>

@code {
    [Parameter]
    public Cancha Cancha { get; set; } = new();

    [Parameter]
    public EventCallback OnValidSubmit { get; set; }

    [Parameter]
    public EventCallback ReturnAction { get; set; }
}