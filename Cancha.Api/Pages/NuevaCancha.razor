@page "/canchas/nueva"
@using Cancha.Shared.Entities 
@using Microsoft.AspNetCore.Components.Forms

<div class="container mt-4 shadow-sm p-4 bg-white rounded">
    <h3 class="mb-4">Registrar Nueva Cancha</h3>

    <EditForm Model="nuevaCancha" OnValidSubmit="GuardarCancha">
        <DataAnnotationsValidator />

        <div class="row">
            @* CAMPO: Nombre *@
            <div class="col-md-6 mb-3">
                <label for="nombre" class="form-label fw-bold">Nombre de la Cancha</label>
                <InputText id="nombre" class="form-control" @bind-value="nuevaCancha.Nombre" placeholder="Ej: Cancha Central" />
                @* Validacion *@
                <ValidationMessage For="@(() => nuevaCancha.Nombre)" class="text-danger small" />
            </div>

            @* CAMPO: Tipo de Cancha (Enum) *@
            <div class="col-md-6 mb-3">
                <label for="tipo" class="form-label fw-bold">Tipo de Cancha</label>
                <InputSelect id="tipo" class="form-select" @bind-Value="nuevaCancha.Tipo">
                    <option value="0">Seleccione un tipo...</option>
                    <option value="@TipoCancha.Futbol">Fútbol</option>
                    <option value="@TipoCancha.FutbolSala">Fútbol Sala</option>
                    <option value="@TipoCancha.Tennis">Tenis</option>
                    <option value="@TipoCancha.Baloncesto">Baloncesto</option>
                    <option value="@TipoCancha.Voleibol">Voleibol</option>
                    <option value="@TipoCancha.Pádel">Pádel</option>
                </InputSelect>
                <ValidationMessage For="@(() => nuevaCancha.Tipo)" class="text-danger small" />
            </div>
        </div>

        <div class="row">
            @* CAMPO: Precio por Hora *@
            <div class="col-md-6 mb-4">
                <label for="precio" class="form-label fw-bold">Precio por Hora</label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <InputNumber id="precio" class="form-control" @bind-Value="nuevaCancha.PrecioHora" />
                </div>
                <ValidationMessage For="@(() => nuevaCancha.PrecioHora)" class="text-danger small" />
            </div>

            @* CAMPO: Activa *@
            <div class="col-md-6 mb-4 d-flex align-items-center">
                <div class="form-check form-switch mt-4">
                    <InputCheckbox id="activa" class="form-check-input" @bind-Value="nuevaCancha.Activa" />
                    <label class="form-check-label" for="activa">Cancha activa y disponible</label>
                </div>
                <ValidationMessage For="@(() => nuevaCancha.Activa)" class="text-danger small" />
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 border-top pt-3">
            <button type="submit" class="btn btn-success">Guardar Cancha</button>
        </div>
    </EditForm>
</div>

@code {
    private CanchaEntidad nuevaCancha = new CanchaEntidad
    {    
        Activa = true 
    };

    private void GuardarCancha()
    {
     Console.WriteLine($"Guardando la cancha: {nuevaCancha.Nombre} de tipo {nuevaCancha.Tipo}");    
    }
}